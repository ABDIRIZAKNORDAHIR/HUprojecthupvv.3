{
  "name": "hormuud-projecthub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "prebuild": "node scripts/generate-pwa-icons.mjs",
    "build": "vite build",
    "build:app": "vite build",
    "preview:app": "vite preview --port 5180 --strictPort",
    "preview:mobile": "node scripts/mobile-preview.mjs",
    "dev": "vite",
    "dev:server": "npm run dev --prefix server",
    "seed": "npm run seed --prefix server",
    "setup:db": "node server/src/setupDatabase.js",
    "setup:db:cloud": "node server/src/setupDatabasePg.js",
    "test-ai": "npm run test-ai --prefix server",
    "setup:ai": "node scripts/setup-ai-key.mjs",
    "setup:free-ai": "node scripts/setup-groq-key.mjs",
    "start:server": "npm run start --prefix server",
    "start": "node scripts/start-and-open.mjs",
    "start:all": "node scripts/start-and-open.mjs",
    "start:production": "node scripts/start-production.mjs",
    "start:full": "node scripts/start-full-stack.mjs",
    "share:internet": "node scripts/share-internet.mjs",
    "share:cloud": "node scripts/share-dev-tunnel.mjs",
    "start:dev": "node scripts/start-dev-windows.mjs --restart",
    "desktop:icon": "node scripts/build-desktop-icon.mjs",
    "desktop": "electron .",
    "desktop:build": "npm run desktop:icon && electron-builder --win portable",
    "export:db": "node server/src/scripts/exportDatabase.js",
    "health-check": "node scripts/health-check.mjs",
    "smoke:frontend": "node scripts/smoke-frontend.mjs",
    "test": "npm test --prefix server",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "security:scan-bundle": "node scripts/scan-frontend-secrets.mjs",
    "security:check": "npm run build && npm run security:scan-bundle"
  },
  "dependencies": {
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "^7.18.2",
    "recharts": "2.15.2",
    "socket.io-client": "^4.8.3",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.61.0",
    "sharp": "^0.35.1",
    "tailwindcss": "4.1.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.3"
    }
  },
  "build": {
    "appId": "so.edu.hu.projecthub",
    "productName": "Hormuud ProjectHub",
    "copyright": "Hormuud University",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "desktop/app-config.cloud.json",
        "to": "app-config.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.png",
      "artifactName": "Hormuud-ProjectHub-${version}-Portable.${ext}",
      "signAndEditExecutable": false
    }
  }
}
