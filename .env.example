# Real AI — Groq (free, default) then Gemini / OpenAI as fallback
# Get a Groq key (no credit card): https://console.groq.com/keys

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Option B — OpenAI ChatGPT (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Option C — Google Gemini (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Provider: auto (prefers Groq) | groq | openai | gemini
AI_PROVIDER=groq
# If primary provider fails, try the other (true unless set to false)
AI_FALLBACK=true

# Local MySQL database (default for this project)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-local-database-password
DB_DATABASE=ProjectHub

# Session signing — use a long random string in production
JWT_SECRET=replace-with-at-least-32-random-characters

# Admin account
ADMIN_EMAIL=admin@example.edu
ADMIN_DEFAULT_PASSWORD=replace-with-a-strong-unique-password
ADMIN_UNIVERSITY_ID=HU0009000

# Email OTP (Gmail App Password for SMTP_PASS) — the only verification channel.
# Recipients only see "Hormuud ProjectHub" branding + logo — OTP goes ONLY to their address (no BCC to you).
# Without SMTP_PASS: development shows the 6-digit code on screen; production refuses to send.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=projecthub@example.edu
SMTP_PASS=
SMTP_FROM=Hormuud ProjectHub <projecthub@example.edu>
OTP_TTL_MINUTES=10

# Web Push (optional � auto-generated if missing; persist for stable subscriptions)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@projecthub.local
